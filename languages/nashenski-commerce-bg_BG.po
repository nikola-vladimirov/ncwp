msgid "Phone format"
msgstr "Формат на телефона"

#: 
msgid "How the shopper types the number. National keeps the leading zero, international adds the country code. Both are saved the same way."
msgstr "Как клиентът въвежда номера. Националният запазва водещата нула, международният добавя кода на държавата. И двата се запазват по един и същ начин."

#: 
msgid "Confirmation email"
msgstr "Имейл за потвърждение"

#: 
