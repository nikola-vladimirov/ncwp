<?xml version="1.0"?>
<ruleset name="Nashenski Commerce">
	<description>WordPress coding standard for Nashenski Commerce.</description>
	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>*/tests/*</exclude-pattern>
		<properties>
			<property name="prefixes" type="array">
				<element value="nashenski"/>
				<element value="Nashenski"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="nashenski-commerce"/>
			</property>
		</properties>
	</rule>
	<!-- The language file is named after the locale, as WordPress names them. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>*/languages/*</exclude-pattern>
	</rule>
	<!-- Offline tests define small stand-ins for WordPress and plugin classes. -->
	<rule ref="Generic.Classes.DuplicateClassName">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<!-- WooCommerce registers these capabilities on the shop manager and administrator roles. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
				<element value="edit_shop_orders"/>
				<element value="view_order"/>
			</property>
		</properties>
	</rule>
</ruleset>
